# Все настройки бэка (app/core/config.py). Закомментированные необязательны,
# значение после `=` у них — значение по умолчанию или пример.

# local | test | production. В production выключены /api/docs и dev-эндпоинты,
# cookie сессии ставится с флагом Secure.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://contentos:contentos@localhost:5433/contentos

# Адрес фронта. Туда возвращает вход через Google.
# APP_URL=http://localhost:5173
# Адрес API, если он на своём поддомене (https://api.<домен>). От него строится redirect URI
# Google. По умолчанию API под APP_URL (/api), как локально через vite proxy.
# API_URL=

# --- Сессии ---

# Origin'ы фронта: им открыт CORS с cookie, только с них принимаются изменяющие запросы
# (JSON-список). В production — адрес фронта, например ["https://app.<домен>"].
# ALLOWED_ORIGINS=["http://localhost:5173"]
# Срок жизни сессии в днях, продлевается при активности.
# SESSION_TTL_DAYS=30

# --- Хранилище файлов (S3-совместимое) ---
# Локально MinIO из compose.yaml: docker compose up -d minio minio-init
# Без S3_BUCKET загрузка фото отвечает 404.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=contentos
S3_SECRET_KEY=contentos
S3_BUCKET=contentos
# Откуда браузер читает публичные файлы (аватары): бакет или CDN перед ним.
S3_PUBLIC_URL=http://localhost:9000/contentos
# Отдельный публичный бакет для avatars/. По умолчанию S3_BUCKET: в MinIO публичен один префикс.
# S3_PUBLIC_BUCKET=
# Адрес хранилища в ссылках для браузера: чтение приватных файлов и прямая загрузка
# (PUT, docs/adr/0013), если API ходит в него по внутреннему адресу. По умолчанию S3_ENDPOINT_URL.
# S3_PRESIGN_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
#
# Cloudflare R2: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto,
# ключи — R2 API token (Object Read & Write на бакет). Браузер кладёт файлы в бакет сам,
# поэтому бакету нужен CORS: AllowedOrigins — адрес фронта, AllowedMethods — PUT, GET,
# AllowedHeaders — content-type. MinIO локально пускает любой Origin и так.
# R2 открывает на чтение только бакет целиком, поэтому аватары — в отдельном бакете:
# S3_PUBLIC_BUCKET=contentos-avatars, у него Public access (r2.dev или свой домен),
# S3_PUBLIC_URL=https://pub-<id>.r2.dev. Основной бакет остаётся закрытым.

# --- Google OAuth ---
# Без них GET /api/auth/google отвечает 404.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: {API_URL или APP_URL}/api/auth/google/callback,
# локально http://localhost:5173/api/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Подсказки адресов в поле Location (API Геосаджеста Яндекс Карт, только Узбекистан).
# Ключ: Кабинет разработчика Яндекса → «API Геосаджеста». Без него поиск адреса отвечает 404.
# YANDEX_GEOSUGGEST_API_KEY=

# --- Telegram: проверка заявок (docs/adr/0001-auth-and-roles.md) ---
# Без этих настроек заявки никуда не отправляются, решение принимается через
# POST /api/dev/review {"email": "...", "decision": "approve" | "reject"}.
# Webhook регистрируется один раз: uv run python -m app.review.set_webhook https://<адрес API>

# Токен от @BotFather.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Секрет, который Telegram присылает в заголовке webhook'а: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=
# Чат, куда приходят заявки. Для лички с ботом совпадает с TELEGRAM_ADMIN_ID,
# у групп отрицательный.
# TELEGRAM_CHAT_ID=
# Telegram user id того, кто одобряет заявки (узнать: @userinfobot).
# TELEGRAM_ADMIN_ID=
